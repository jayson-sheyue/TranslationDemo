# Required by every Cloud Translation API v3 request.
GOOGLE_CLOUD_PROJECT=your-project-id

# Application Default Credentials. Do not commit the JSON key itself.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# The demo's default resource location. Use us-central1 for glossary / batch / document examples.
TRANSLATION_LOCATION=us-central1

# For local development only. Set false when exposing the application.
DEMO_DEBUG=false

# Optional local port when using: uvicorn app:app --port $DEMO_PORT
# Cloud Run injects PORT automatically; local README default remains 8010.
# DEMO_PORT=8010
